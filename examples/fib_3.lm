true = \a.\b.a
false = \a.\b.b
zero = \f.\x.x
succ = \n.\f.\x.f (n f x)

is_zero = \n.n (\x.false) true
plus = \m.\n.\f.\x.m f (n f x)
pred = \n.\f.\x.n (\g.\h.h (g f)) (\u.x) (\u.u)

yy = \f.(\x.f (x x)) (\x.f (x x))

fib = yy (\f.\n.(is_zero n) zero ((is_zero (pred n)) (succ zero) (plus (f (pred n)) (f (pred (pred n))))))
fib (succ (succ (succ zero)))
